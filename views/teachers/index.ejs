<%- include('../partials/header') %>

<h1>Преподаватели</h1>

<% if (typeof deleteError !== 'undefined' && deleteError) { %>
    <div class="error-box"><%= deleteError %></div>
<% } %>

<% if (teachers.length === 0) { %>
    <p class="empty-state">Преподаватели не найдены</p>
<% } else { %>
    <table>
        <thead>
            <tr>
                <th>Имя</th>
                <th>Email</th>
                <th>Кафедра</th>
                <th>Учёная степень</th>
                <th>Курсов</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            <% teachers.forEach(teacher => { %>
                <tr>
                    <td><%= teacher.name %></td>
                    <td><%= teacher.email %></td>
                    <td><%= teacher.department %></td>
                    <td><%= teacher.academicDegree %></td>
                    <td><%= teacher.courses ? teacher.courses.length : 0 %></td>
                    <td class="actions">
                        <a href="/teachers/<%= teacher.id %>" class="btn btn-view">Просмотр</a>
                        <a href="/teachers/<%= teacher.id %>/edit" class="btn btn-edit">Редактировать</a>
                        <form action="/teachers/<%= teacher.id %>/delete" method="POST" class="inline-form"
                              onsubmit="return confirm('Вы действительно хотите удалить этого преподавателя?')">
                            <button type="submit" class="btn btn-delete">Удалить</button>
                        </form>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
<% } %>

<%- include('../partials/footer') %>
