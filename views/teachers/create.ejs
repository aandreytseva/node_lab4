<%- include('../partials/header') %>

<h1>Добавить преподавателя</h1>

<% if (errors && errors.length > 0) { %>
    <div class="error-box">
        <ul>
            <% errors.forEach(error => { %>
                <li><%= error %></li>
            <% }) %>
        </ul>
    </div>
<% } %>

<form action="/teachers" method="POST" class="form">
    <div class="form-group">
        <label for="name">Имя:</label>
        <input type="text" id="name" name="name" value="<%= teacher.name || '' %>" required>
    </div>
    <div class="form-group">
        <label for="email">Email:</label>
        <input type="email" id="email" name="email" value="<%= teacher.email || '' %>" required>
    </div>
    <div class="form-group">
        <label for="department">Кафедра:</label>
        <input type="text" id="department" name="department" value="<%= teacher.department || '' %>" required>
    </div>
    <div class="form-group">
        <label for="academicDegree">Учёная степень:</label>
        <input type="text" id="academicDegree" name="academicDegree" value="<%= teacher.academicDegree || '' %>" required>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Сохранить</button>
        <a href="/teachers" class="btn btn-back">Отмена</a>
    </div>
</form>

<%- include('../partials/footer') %>
