<%- include('../partials/header') %>

<h1>Добавить курс</h1>

<% if (errors && errors.length > 0) { %>
    <div class="error-box">
        <ul>
            <% errors.forEach(error => { %>
                <li><%= error %></li>
            <% }) %>
        </ul>
    </div>
<% } %>

<form action="/courses" method="POST" class="form">
    <div class="form-group">
        <label for="title">Название:</label>
        <input type="text" id="title" name="title" value="<%= course.title || '' %>" required>
    </div>
    <div class="form-group">
        <label for="credits">Количество кредитов:</label>
        <input type="number" id="credits" name="credits" min="1" value="<%= course.credits || '' %>" required>
    </div>
    <div class="form-group">
        <label for="semester">Семестр:</label>
        <select id="semester" name="semester" required>
            <option value="">Выберите семестр</option>
            <% for (let i = 1; i <= 8; i++) { %>
                <option value="<%= i %>" <%= course.semester == i ? 'selected' : '' %>><%= i %></option>
            <% } %>
        </select>
    </div>
    <div class="form-group">
        <label for="description">Описание:</label>
        <textarea id="description" name="description" rows="4" required><%= course.description || '' %></textarea>
    </div>
    <div class="form-group">
        <label for="teacherId">Преподаватель:</label>
        <select id="teacherId" name="teacherId" required>
            <option value="">Выберите преподавателя</option>
            <% teachers.forEach(t => { %>
                <option value="<%= t.id %>" <%= course.teacherId == t.id ? 'selected' : '' %>><%= t.name %></option>
            <% }) %>
        </select>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Сохранить</button>
        <a href="/courses" class="btn btn-back">Отмена</a>
    </div>
</form>

<%- include('../partials/footer') %>
