<%- include('../partials/header') %>

<h1>Курсы</h1>

<form action="/courses" method="GET" class="filter-form">
    <div class="filter-row">
        <div class="filter-group">
            <label for="search">Поиск по названию:</label>
            <input type="text" id="search" name="search" value="<%= search %>" placeholder="Введите название...">
        </div>
        <div class="filter-group">
            <label for="teacherId">Преподаватель:</label>
            <select id="teacherId" name="teacherId">
                <option value="">Все преподаватели</option>
                <% teachers.forEach(t => { %>
                    <option value="<%= t.id %>" <%= selectedTeacherId == t.id ? 'selected' : '' %>><%= t.name %></option>
                <% }) %>
            </select>
        </div>
        <div class="filter-group">
            <label for="semester">Семестр:</label>
            <select id="semester" name="semester">
                <option value="">Все семестры</option>
                <% for (let i = 1; i <= 8; i++) { %>
                    <option value="<%= i %>" <%= selectedSemester == i ? 'selected' : '' %>><%= i %></option>
                <% } %>
            </select>
        </div>
        <div class="filter-group filter-actions">
            <button type="submit" class="btn btn-primary">Найти</button>
            <a href="/courses" class="btn btn-back">Сбросить</a>
        </div>
    </div>
</form>

<% if (courses.length === 0) { %>
    <p class="empty-state">Курсы не найдены</p>
<% } else { %>
    <table>
        <thead>
            <tr>
                <th>Название</th>
                <th>Преподаватель</th>
                <th>Кредиты</th>
                <th>Семестр</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            <% courses.forEach(course => { %>
                <tr>
                    <td><%= course.title %></td>
                    <td><%= course.teacher ? course.teacher.name : 'Не назначен' %></td>
                    <td><%= course.credits %></td>
                    <td><%= course.semester %></td>
                    <td class="actions">
                        <a href="/courses/<%= course.id %>" class="btn btn-view">Просмотр</a>
                        <a href="/courses/<%= course.id %>/edit" class="btn btn-edit">Редактировать</a>
                        <form action="/courses/<%= course.id %>/delete" method="POST" class="inline-form"
                              onsubmit="return confirm('Вы действительно хотите удалить этот курс?')">
                            <button type="submit" class="btn btn-delete">Удалить</button>
                        </form>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
<% } %>

<%- include('../partials/footer') %>
